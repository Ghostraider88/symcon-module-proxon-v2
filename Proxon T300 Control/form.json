{
    "elements": [
        {
            "name": "Interval",
            "type": "NumberSpinner",
            "caption": "Poll Interval",
            "minimum": 0,
            "maximum": 86400,
            "suffix": "Seconds"
        },
        {
            "name": "AdvancedControlsEnabled",
            "type": "CheckBox",
            "caption": "Enable Maintenance and Setup Controls"
        },
        {
            "type": "Label",
            "caption": "Operating controls (2000-2003, PV and Legionella) are enabled by default. Maintenance and initial setup controls require this option."
        },
        {
            "type": "Label",
            "caption": "Enable Modbus write access in the T300 controller before using the controls."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Create Monitoring Instance",
            "onClick": "PROXONT300_CreateMonitoringInstance($id);"
        },
        {
            "type": "Button",
            "caption": "Update Values",
            "onClick": "PROXONT300_RequestStatus($id);"
        }
    ],
    "status": [

        {"code": 104, "icon": "information", "caption": "Automatic polling is disabled; use Update Values for a manual poll."},
        {"code": 202, "icon": "error", "caption": "Modbus read failed or no active parent connection is available."},
        {"code": 203, "icon": "error", "caption": "Polling interval must be 0 or between 5 and 86400 seconds."}
]
}

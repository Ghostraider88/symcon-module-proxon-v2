{
    "elements": [
        {
            "name": "Interval",
            "type": "NumberSpinner",
            "caption": "Polling interval",
            "minimum": 0,
            "maximum": 86400,
            "suffix": "Seconds"
        },
        {
            "name": "PowerVariableID",
            "type": "SelectVariable",
            "caption": "Archived total electrical power (W)",
            "validVariableTypes": [1, 2]
        },
        {
            "name": "DeviceFilterRemainingHoursAtReference",
            "type": "NumberSpinner",
            "caption": "Remaining filter runtime from app",
            "suffix": "hours"
        },
        {
            "type": "Label",
            "caption": "Convert the app value to total hours (days × 24 + additional hours). Apply the setting, then capture the reference. The estimate assumes the app value and register 4x0469 use the same operating-hour basis, and 4x0469 counts since replacement."
        },
        {
            "type": "Label",
            "caption": "Select a logged total electrical power variable in watts to calculate daily, monthly and yearly consumption from archive averages. The module does not enable archive logging. Energy Since First Sample remains a local estimate."
        },
        {
            "type": "Label",
            "caption": "Service commands are only available here in the backend. Reset clears pending faults; restart temporarily interrupts the system. Neither command is sent during monitoring."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update values",
            "onClick": "PROXONMON_RequestStatus($id);"
        },
        {
            "type": "Button",
            "caption": "Capture filter runtime reference",
            "onClick": "PROXONMON_CaptureDeviceFilterRuntimeReference($id);"
        },
        {
            "type": "PopupButton",
            "caption": "Reset pending faults",
            "popup": {
                "caption": "Confirm fault reset",
                "closeCaption": "Cancel",
                "items": [
                    {
                        "type": "Label",
                        "caption": "This writes the FWT fault reset command. It does not clear the displayed history in Symcon."
                    }
                ],
                "buttons": [
                    {
                        "name": "ConfirmReset",
                        "caption": "Reset faults",
                        "onClick": "PROXONMON_ResetPendingFaults($id);"
                    }
                ]
            }
        },
        {
            "type": "PopupButton",
            "caption": "Restart FWT controller",
            "popup": {
                "caption": "Confirm device restart",
                "closeCaption": "Cancel",
                "items": [
                    {
                        "type": "Label",
                        "caption": "This restarts the FWT controller and temporarily interrupts communication and operation."
                    }
                ],
                "buttons": [
                    {
                        "name": "ConfirmRestart",
                        "caption": "Restart controller",
                        "onClick": "PROXONMON_RestartController($id);"
                    }
                ]
            }
        }
    ]
,
    "status": [
        {"code": 104, "icon": "information", "caption": "Automatic polling is disabled; use Update Values for a manual poll."},
        {"code": 202, "icon": "error", "caption": "Modbus read failed or no active parent connection is available."},
        {"code": 203, "icon": "error", "caption": "Polling interval must be 0 or between 5 and 86400 seconds."}

    ]
}

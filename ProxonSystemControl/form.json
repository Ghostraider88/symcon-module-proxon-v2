{
	"elements": [
		{
			"name": "Interval",
			"type": "NumberSpinner",
			"caption": "Interval",
			"suffix": "Seconds"
		},
		{
			"name": "MonitoringInstanceID",
			"type": "SelectInstance",
			"caption": "Heat Pump Monitoring Instance",
			"validModules": ["{C48CB61D-8500-41F3-AC35-82DAF84EC870}"]
		},
		{
			"name": "CO2RFSensorCount",
			"type": "NumberSpinner",
			"caption": "CO2/RF Sensor Count",
			"minimum": 1,
			"maximum": 5
		},
		{
			"name": "AdvancedControlsEnabled",
			"type": "CheckBox",
			"caption": "Enable Advanced Controls"
		},
		{
			"type": "Label",
			"caption": "Advanced controls include compressor, heat pump, bypass temperature, airflow tuning and panel sensor calibration settings. Incorrect values can impair or damage the system."
		}
	],
	"actions": [
		{
			"type": "Button",
			"caption": "Update Values",
			"onClick": "PROXON_RequestStatus($id);"
		},
		{
			"type": "Button",
			"caption": "Create Monitoring Instance",
			"onClick": "PROXON_CreateMonitoringInstance($id);"
		},
		{
			"type": "Button",
			"caption": "Create Advanced Instance",
			"onClick": "PROXON_CreateAdvancedInstance($id);"
		}
	]
}
